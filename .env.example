# MongoDB Atlas (required — used for both data storage and job scheduling)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=agentic_demo

# Atlas Metrics API (required only when COLLECTOR_ADAPTER=mcp)
ATLAS_PROJECT_ID=
ATLAS_CLUSTER_NAME=perf-demo
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=

# API Server
API_PORT=4000
API_METRICS_PORT=4001
API_HOST=0.0.0.0

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Actuator
ACTUATOR_MODE=dry_run
ACTUATOR_MAX_TIER=M60
ACTUATOR_COOLDOWN_MINUTES=30

# Collector
COLLECTOR_INTERVAL_SECONDS=30
COLLECTOR_ADAPTER=mock
# Mock 시나리오: normal | connection_surge | cpu_saturation | storage_pressure | query_inefficiency
COLLECTOR_MOCK_SCENARIO=normal

# Detector
RULE_WINDOW_MINUTES=5

# Worker Metrics Ports
COLLECTOR_METRICS_PORT=4010
DETECTOR_METRICS_PORT=4011
ACTUATOR_METRICS_PORT=4012

# Observability
PROMETHEUS_ENABLED=true
